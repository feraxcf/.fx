[Default Applications]
x-scheme-handler/discord=vesktop.desktop

# text -> dev.zed.Zed.desktop
text/csv=dev.zed.Zed.desktop
text/plain=dev.zed.Zed.desktop
text/html=dev.zed.Zed.desktop

# URI scheme handlers -> zen-browser.desktop
x-scheme-handler/mailto=zen-browser.desktop
x-scheme-handler/http=zen-browser.desktop
x-scheme-handler/https=zen-browser.desktop

# Aplication -> zen-browser.desktop
application/xhtml+xml=zen-browser.desktop

# Images -> zen-browser.desktop
application/pdf=zen-browser.desktop
image/x-compressed-xcf=zen-browser.desktop
image/x-xcf=zen-browser.desktop
image/x-psd=zen-browser.desktop
image/x-fits=zen-browser.desktop
image/vnd.rn-realpix=zen-browser.desktop
image/x-pict=zen-browser.desktop
image/bmp=zen-browser.desktop
image/gif=zen-browser.desktop
image/jpeg=zen-browser.desktop
image/jpg=zen-browser.desktop
image/pjpeg=zen-browser.desktop
image/png=zen-browser.desktop
image/tiff=zen-browser.desktop
image/x-bmp=zen-browser.desktop
image/x-gray=zen-browser.desktop
image/x-icb=zen-browser.desktop
image/x-ico=zen-browser.desktop
image/x-png=zen-browser.desktop
image/x-portable-anymap=zen-browser.desktop
image/x-portable-bitmap=zen-browser.desktop
image/x-portable-graymap=zen-browser.desktop
image/x-portable-pixmap=zen-browser.desktop
image/x-xbitmap=zen-browser.desktop
image/x-xpixmap=zen-browser.desktop
image/x-pcx=zen-browser.desktop
image/svg+xml=zen-browser.desktop
image/svg+xml-compressed=zen-browser.desktop
image/vnd.wap.wbmp=zen-browser.desktop
image/x-icns=zen-browser.desktop
image/x-eps=zen-browser.desktop
image/x-bzeps=zen-browser.desktop
image/x-gzeps=zen-browser.desktop
image/vnd.djvu+multipage=zen-browser.desktop
image/tiff=zen-browser.desktop